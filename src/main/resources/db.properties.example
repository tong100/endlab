# ============================================================
# 数据库连接配置模板
# 使用方法：把本文件复制一份改名为 db.properties（放在同一目录），
#          然后把 jdbc.user / jdbc.password 改成你本地 MySQL 的账号密码。
# 注意：db.properties 已被 .gitignore 忽略，不会上传到 GitHub。
# ============================================================
jdbc.driver=com.mysql.cj.jdbc.Driver
jdbc.url=jdbc:mysql://localhost:3306/lab_equipment?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
jdbc.user=root
jdbc.password=你的MySQL密码
