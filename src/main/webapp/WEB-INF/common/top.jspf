<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<%-- 顶部公共骨架：DOCTYPE + head（引全站CSS）+ 导航栏 + 主体容器开标签
     各页面开头 include 本片段，结尾 include bottom.jspf --%>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${empty pageTitle ? '实验室设备借用系统' : pageTitle} - 实验室设备借用系统</title>
    <link rel="stylesheet" href="${ctx}/static/style.css">
</head>
<body>
<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="${ctx}/">
            <span class="brand-logo">⚗</span>
            <span class="brand-name">实验室设备借用系统</span>
        </a>
        <nav class="topnav">
            <c:choose>
                <c:when test="${sessionScope.role == 1}">
                    <a href="${ctx}/equipment" class="${activeNav == 'equipment' ? 'active' : ''}">设备管理</a>
                    <a href="${ctx}/audit" class="${activeNav == 'audit' ? 'active' : ''}">借用审批</a>
                    <a href="${ctx}/repair?act=list" class="${activeNav == 'repair' ? 'active' : ''}">报修管理</a>
                    <a href="${ctx}/sysLog" class="${activeNav == 'sysLog' ? 'active' : ''}">操作日志</a>
                </c:when>
                <c:otherwise>
                    <a href="${ctx}/borrowApply?act=myList" class="${activeNav == 'myList' ? 'active' : ''}">我的借用</a>
                    <a href="${ctx}/borrowApply?act=add" class="${activeNav == 'add' ? 'active' : ''}">新建借用</a>
                    <a href="${ctx}/repair?act=add" class="${activeNav == 'repairAdd' ? 'active' : ''}">设备报修</a>
                </c:otherwise>
            </c:choose>
        </nav>
        <div class="user-box">
            <span class="avatar">${fn:substring(sessionScope.loginUser.name, 0, 1)}</span>
            <span class="username">${sessionScope.loginUser.name}</span>
            <span class="role-tag">${sessionScope.role == 1 ? '管理员' : '学生'}</span>
            <a class="logout" href="${ctx}/login?act=logout">退出</a>
        </div>
    </div>
</header>
<main class="container">
