<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%-- 顶部导航栏公共片段：各页面在 <body> 开头静态 include --%>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="${ctx}/">⚗ 实验室设备借用系统</a>
        <nav class="topnav">
            <c:choose>
                <c:when test="${sessionScope.role == 1}">
                    <a href="${ctx}/equipment" class="${activeNav == 'equipment' ? 'active' : ''}">设备管理</a>
                    <a href="${ctx}/audit" class="${activeNav == 'audit' ? 'active' : ''}">借用审批</a>
                    <a href="${ctx}/repair?act=list" class="${activeNav == 'repair' ? 'active' : ''}">报修管理</a>
                    <a href="${ctx}/sysLog" class="${activeNav == 'sysLog' ? 'active' : ''}">操作日志</a>
                </c:when>
                <c:otherwise>
                    <a href="${ctx}/borrowApply?act=myList" class="${activeNav == 'myList' ? 'active' : ''}">我的借用</a>
                    <a href="${ctx}/borrowApply?act=add" class="${activeNav == 'add' ? 'active' : ''}">新建借用</a>
                    <a href="${ctx}/repair?act=add" class="${activeNav == 'repairAdd' ? 'active' : ''}">设备报修</a>
                </c:otherwise>
            </c:choose>
        </nav>
        <div class="user-box">
            <span class="username">${sessionScope.loginUser.name}</span>
            <span>（${sessionScope.role == 1 ? '管理员' : '学生'}）</span>
            <a class="logout" href="${ctx}/login?act=logout">退出登录</a>
        </div>
    </div>
</header>
<main class="container">
